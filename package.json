{
  "name": "hemodinks-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.11",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^10.9.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "analyze": "tsc -b && vite build --mode analyze",
    "budget": "node scripts/check-bundle-budget.mjs",
    "audit:architecture": "node scripts/check-frontend-architecture.mjs",
    "security-headers": "node scripts/security-headers.mjs",
    "security-headers:write": "node scripts/security-headers.mjs --write",
    "lint": "eslint src --max-warnings 0",
    "verify": "npm run audit:architecture && npm run security-headers && npm run lint && npm test && npm run build",
    "audit:a11y": "playwright test --grep acessibilidade",
    "audit:lighthouse": "node scripts/run-lighthouse.mjs",
    "test:performance": "node --test scripts/check-bundle-budget.test.mjs scripts/lighthouse-fixtures.test.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "test:release-gate": "node --test scripts/release-gate.test.mjs scripts/coverage-summary.test.mjs",
    "test:security-headers": "node --test scripts/security-headers.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:csp": "playwright test -c playwright.csp.config.ts",
    "test:e2e:responsive": "playwright test --config=playwright.responsive.config.ts",
    "test:e2e:homologation": "playwright test --config=playwright.homologation.config.ts",
    "test:e2e:real": "node scripts/run-real-api.mjs",
    "test:e2e:real:policy": "node --test scripts/real-api-policy.test.mjs",
    "record:tutorials": "playwright test --config=playwright.tutorials.config.ts",
    "record:tutorials:reports": "playwright test --config=playwright.tutorials.config.ts --project=tutorial-reports",
    "record:tutorials:reports:local": "playwright test --config=playwright.tutorials.local.config.ts",
    "tutorial:setup": "tsx scripts/tutorials/setup-tools.ts",
    "tutorial:verify:pronunciation": "tsx scripts/tutorials/verify-pronunciation.ts",
    "tutorial:audit": "tsx scripts/tutorials/audit.ts",
    "tutorial:audio": "tsx scripts/tutorials/generate-audio.ts",
    "tutorial:audio:dry-run": "tsx scripts/tutorials/generate-audio.ts --dry-run",
    "tutorial:voice-preview": "tsx scripts/tutorials/voice-preview.ts",
    "tutorial:record": "tsx scripts/tutorials/record-tutorial.ts",
    "tutorial:record:all": "npm run tutorial:audit && npm run tutorial:record:library && npm run tutorial:compose:library",
    "tutorial:audio:reports": "tsx scripts/tutorials/generate-narration.ts",
    "tutorial:compose:reports": "tsx scripts/tutorials/compose-video.ts",
    "tutorial:produce:reports": "npm run tutorial:setup && npm run tutorial:audio:reports && npm run record:tutorials:reports:local && npm run tutorial:compose:reports",
    "tutorial:audio:library": "tsx scripts/tutorials/generate-library-narration.ts",
    "tutorial:record:library": "playwright test --config=playwright.tutorials.library.config.ts",
    "tutorial:compose:library": "tsx scripts/tutorials/compose-library-videos.ts",
    "tutorial:produce:library": "npm run tutorial:setup && npm run tutorial:audio:library && npm run tutorial:record:library && npm run tutorial:compose:library",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@newrelic/browser-agent": "^1.323.0",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.20.0",
    "driver.js": "^1.8.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.555.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "fflate": "0.8.3",
    "basic-ftp": "6.2.1",
    "uuid": "11.1.1",
    "tmp": "0.2.7"
  }
}
