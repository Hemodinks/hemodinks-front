{
  "$comment": "Fonte única da CSP e dos headers de segurança (#266). Edite aqui e rode `npm run security-headers:write`; `npm run test:security-headers` (CI) falha se algum destino divergir.",
  "contentSecurityPolicy": {
    "default-src": ["'self'"],
    "base-uri": ["'none'"],
    "object-src": ["'none'"],
    "frame-ancestors": ["'self'"],
    "form-action": ["'self'"],
    "img-src": ["'self'", "data:", "blob:", "https://hemodinks-api-prod.politepond-d8524c51.brazilsouth.azurecontainerapps.io"],
    "font-src": ["'self'", "data:"],
    "style-src": ["'self'"],
    "script-src": ["'self'"],
    "script-src-attr": ["'none'"],
    "connect-src": [
      "'self'",
      "https://hemodinks-api-prod.politepond-d8524c51.brazilsouth.azurecontainerapps.io",
      "https://date.nager.at",
      "https://bam.nr-data.net",
      "https://bam-cell.nr-data.net"
    ],
    "worker-src": ["'self'", "blob:"],
    "manifest-src": ["'self'"],
    "upgrade-insecure-requests": []
  },
  "headers": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "SAMEORIGIN",
    "Permissions-Policy": "camera=(), geolocation=(), microphone=()"
  },
  "targets": {
    "azure-production": {
      "file": "public/staticwebapp.config.json",
      "format": "azure",
      "headers": { "Strict-Transport-Security": "max-age=31536000" }
    },
    "vercel-homologation": {
      "file": "vercel.json",
      "format": "vercel",
      "cspAppend": {
        "connect-src": ["https://hemodinks-api-1-90nb.onrender.com"],
        "img-src": ["https://hemodinks-api-1-90nb.onrender.com"]
      },
      "headers": {
        "Strict-Transport-Security": "max-age=31536000",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    "docker-nginx": {
      "file": "nginx.conf",
      "format": "nginx"
    },
    "docker-nginx-proxy": {
      "file": "nginx.proxy.conf.template",
      "format": "nginx"
    }
  }
}
