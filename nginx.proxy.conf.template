server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; script-src-attr 'none'; connect-src 'self' https://hemodinks-api-prod.politepond-d8524c51.brazilsouth.azurecontainerapps.io https://hemodinks-api-1-90nb.onrender.com https://hemodinks-api-confirmation.onrender.com https://date.nager.at https://bam.nr-data.net https://bam-cell.nr-data.net; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    proxy_read_timeout 120s;
  }
  location / {
    try_files $uri $uri/ /index.html;
  }
  location = /index.html {
    expires -1;
  }
  location = /otel-runtime-config.json {
    expires -1;
  }
  location /assets/ {
    expires 1y;
    try_files $uri =404;
  }
}
